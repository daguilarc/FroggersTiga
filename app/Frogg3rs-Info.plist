<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Bundle metadata for the direct-launch Frogg3rs app.
     juce_build.mk:154 copies this file verbatim into
     Frogg3rs.app/Contents/Info.plist -- there is no templating, so
     CFBundleExecutable must match APP_NAME in app/build-launcher.sh exactly.
     If they disagree, LaunchServices looks for a binary that is not there and
     a Finder double-click fails while a direct exec of the binary still works,
     which makes the breakage easy to miss. CFBundleIdentifier is deliberately
     distinct from sheaf-patch's dev.sheaf.SheafPatch: two bundles sharing one
     identifier let LaunchServices resolve the wrong app.

     CFBundleIconFile should use the same
     logo as the v1 build: v1's JUCE CMake build got its
     icon for free (desktop/CMakeLists.txt's ICON_BIG/ICON_SMALL generate both
     the .icns and this key automatically), but this Sheaf-bundle path has no
     such step -- juce_build.mk:152-154 only copies the binary and this plist,
     verbatim, with no resource stage at all. So the same "copied verbatim,
     no templating" fact above applies here too: setting this key is not
     enough by itself. The icon file it names must actually exist at
     Contents/Resources/Icon.icns, and since juce_build.mk never creates a
     Resources/ directory, app/build-launcher.sh is what puts it there after
     the bundle is built (see that script's own comment). Without that copy
     step, this key just names a file that is not in the bundle and Finder
     silently falls back to the generic icon -- another failure that hides
     from a build-exit-code check, same shape as the CFBundleExecutable
     mismatch above. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>Frogg3rs</string>
  <key>CFBundleIconFile</key>
  <string>Icon.icns</string>
  <key>CFBundleIdentifier</key>
  <string>dev.sheaf.Frogg3rs</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Frogg3rs</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
