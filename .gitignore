# Host build/package outputs
app/browser/dist/
.DS_Store
**/.DS_Store

# app/browser/e2e/'s own Playwright harness (own package.json,
# not covered by any existing ignore). Same convention web/.gitignore
# already uses for its own e2e node_modules/test-results/playwright-report,
# scoped here since this file is the root .gitignore, not a nested one.
app/browser/e2e/node_modules/
app/browser/e2e/test-results/
app/browser/e2e/playwright-report/

# Local execution ledger (scratch progress notes, not versioned)
.sdd/
# Playwright scratch when a suite is run from the repo root rather than its own dir.
/test-results/

# Agent tooling: local to whoever is working, not part of the product
.claude/
.cursor/

# Daisy firmware build output: the field firmware source is kept, its builds are not
src/*/build/

# Host-side firmware test build output (cmake -S test/firmware -B test/firmware/build)
test/firmware/build/

# Archived openspec changes stay local: they are a working record, not
# something the published repo needs to carry.
openspec/changes/archive/
