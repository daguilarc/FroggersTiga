.sdd/
# Playwright scratch when a suite is run from the repo root rather than its own dir.
/test-results/

# Agent tooling: local to whoever is working, not part of the product
.claude/
.cursor/

# Daisy firmware build output: the field firmware source is kept, its builds are not
src/*/build/
