#!/usr/bin/env bash
# Keep the operator-doc mirrors from drifting.
#
# SIM_MANUAL.md and QUICK_DICT.md each have byte-identical mirrors under docs/
# and web/public/. `sim/check_operator_docs_sync.sh` enforces that -- but it runs
# in pages.yml, i.e. AFTER a push. So the failure mode was: edit a root doc,
# forget `scripts/sync-help-docs.sh`, and find out when the deploy goes red.
# That is exactly what happened to docs/sim-manual.md, which sat drifted at HEAD
# until 2026-08-13.
#
# The mirrors are pure copies with the root file canonical (sync-help-docs.sh
# defines that), so there is no judgement to make here: if they differ, re-copy
# and re-stage. Editing a mirror directly is not a supported workflow -- the
# CI check would reject it regardless.
#
# Install with: scripts/hooks/install.sh
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

if [ ! -x sim/check_operator_docs_sync.sh ]; then
  exit 0
fi

if sim/check_operator_docs_sync.sh >/dev/null 2>&1; then
  exit 0
fi

# The sync check also enforces a launch-gate on the public SIM manual (no
# VST/AU/plugin/VCV/Rack mentions). Re-copying cannot fix that one, so re-run
# afterwards and fail loudly if something other than drift is wrong.
sh scripts/sync-help-docs.sh >/dev/null

if ! sim/check_operator_docs_sync.sh; then
  echo "pre-commit: operator docs still fail after syncing -- not just drift." >&2
  echo "pre-commit: fix the reported problem by hand, then commit again." >&2
  exit 1
fi

MIRRORS="docs/sim-manual.md web/public/sim-manual.md docs/quick-dict.md web/public/quick-dict.md web/public/license.md"
RESTAGED=""
for f in $MIRRORS; do
  if [ -f "$f" ] && ! git diff --quiet -- "$f"; then
    git add -- "$f"
    RESTAGED="$RESTAGED $f"
  fi
done

if [ -n "$RESTAGED" ]; then
  echo "pre-commit: re-synced and staged operator doc mirrors:$RESTAGED"
fi

exit 0
